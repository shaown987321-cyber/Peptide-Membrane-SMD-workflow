define                  = -DPOSRES  
integrator              = md        
nsteps                  = 500000    
dt                      = 0.002    
nstxout                 = 50000      
nstvout                 = 50000      
nstenergy               = 50000      
nstlog                  = 50000     

continuation            = no        
constraint_algorithm    = lincs    
constraints             = h-bonds   
lincs_iter              = 1         
lincs_order             = 4         


cutoff-scheme           = Verlet        
nstlist                 = 10        
rvdw                    = 1.2       
rvdw-switch             = 1.0
vdw-modifier            = force-switch

DispCorr                = No        
rcoulomb                = 1.2       
coulombtype             = PME       
pme_order               = 4        
fourierspacing          = 0.16 
    
tcoupl                  = V-rescale  
tc-grps                 = System 
tau_t                   = 1.0       
ref_t                   = 310.15      
pcoupl                  = no        
pbc                     = xyz       
gen_vel                 = yes       
gen_temp                = 310.15       
gen_seed                = -1        
