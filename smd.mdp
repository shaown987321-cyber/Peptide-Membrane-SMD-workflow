; Run parameters
integrator              = md
dt                      = 0.001
tinit                   = 0
nsteps                  = 60000000
nstxout-compressed      = 125000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstenergy               = 5000
nstlog                  = 5000

; Nonbonded interactions
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2

; Temperature coupling
Tcoupl                  = Nose-Hoover
tc_grps                 = Protein MEMB    SOL
tau_t                   = 1.0     1.0     1.0
ref_t                   = 310.15  310.15  310.15

; Pressure coupling
Pcoupl                  = Parrinello-Rahman
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 1.0     1.0

; Constraints
constraints             = h-bonds
constraint_algorithm    = LINCS

; COM removal
nstcomm                 = 100
comm_mode               = linear
comm_grps               = Protein MEMB SOL

; Velocity generation
gen-vel                 = no
gen_temp                = 310.15
gen_seed                = -1
continuation            = yes

pbc                     = xyz


; Pull code
pull                        = yes
pull_ncoords                = 1
pull_ngroups                = 2

pull_group1_name            = MEMB
pull_group2_name            = Protein

pull-group1-pbcatom         = 7989
pull-group2-pbcatom         = 104

pull-pbc-ref-prev-step-com  = yes

pull_coord1_type            = umbrella
pull_coord1_geometry        = direction
pull_coord1_groups          = 1 2
pull_coord1_dim             = N N Y
pull_coord1_vec             = 0 0 -1

pull_coord1_start           = yes
pull_coord1_rate            = 0.00007467
pull_coord1_k               = 1000
